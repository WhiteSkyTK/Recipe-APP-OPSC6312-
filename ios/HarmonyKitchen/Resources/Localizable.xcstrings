    },
    "morning_greetings.7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coffee first, then conquer the day! ☕"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Kofi pele, ke moka o fenye letšatši! ☕"
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "Kofi ro sungula, kutani u hlula siku! ☕"
          }
        },
        "ve": {
          "stringUnit": {
            "state": "translated",
            "value": "Kofi u thoma, ni kone u kunda ḓuvha! ☕"
          }
        }
      }
    },
