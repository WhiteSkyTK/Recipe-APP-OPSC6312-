    "report_issue_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n--- Please Do Not Edit Below This Line ---\n App Version: %1$@\n Device: %2$@\n Android Version: %3$@\n User ID: %4$@\n --- PLease Explain Here ---\n"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n--- Hle O se ke wa Fetola Ka Tlase ga Mothaladi Wo ---\n Phetolelo ya App: %1$@\n Sedirišwa: %2$@\n Phetolelo ya Android: %3$@\n Boitsibisho bja Mošomi: %4$@\n --- Hle Hlalosa Fa ---\n"
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n--- H kombela u nga Lulamisi ehansi ka Layini leyi ---\n Vuhundzuluxeri bya App: %1$@\n Xitirhisiwa: %2$@\n Vuhundzuluxeri bya Android: %3$@\n ID ya Mutirhisi: %4$@\n --- H kombela u Hlamusela Laha ---\n"
          }
        },
        "ve": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n--- Ndi khou humbela ni songo Shandukisa fhasi ha Mutala uyu ---\n Vhendo ya App: %1$@\n Mudziyo: %2$@\n Vhendo ya Android: %3$@\n ID ya Mushumisi: %4$@\n --- Ndi khou humbela Ṱhalutshedzani Hafha ---\n"
          }
        }
      }
    },
