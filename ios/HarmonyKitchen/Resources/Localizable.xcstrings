    "harmony_kitchen_is_a_final_year_project_designed_to_bring_delicious_easy_to_make_recipes_to_your_fingertips_tailored_to_the_ingredients_you_have_and_the_flavors_you_love": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Harmony Kitchen is a final year project designed to bring delicious, easy-to-make recipes to your fingertips, tailored to the ingredients you have and the flavors you love."
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Harmony Kitchen ke projeke ya ngwaga wa mafelelo yeo e hlamilwego go go tlisetsa diresipi tsa go natefa le tse bonolo go di dira ka matsogo a gago, di dirilwe go ya ka ditswako tseo o nago le tsona le ditatso tseo o di ratago."
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "Harmony Kitchen i phurojeke ya lembe ro hetelela leyi endleriweke ku tisa swakudya swa nandziha na swo olova ku swi endla, swi fambisana na swilala leswi u nga na swona na swin'wiw'wi leswi u swi rhandzaka."
          }
        },
        "ve": {
          "stringUnit": {
            "state": "translated",
            "value": "Harmony Kitchen ndi phurojeki ya ṅwaha wa u fhedza yo itelwaho u ḓisa diresepi dza u ḓifha na dza olovha u ita, zwo itelwaho zwi shumiswaho zwine na vha nazwo na zwidovho zwine na zwi funa."
          }
        }
      }
    },
