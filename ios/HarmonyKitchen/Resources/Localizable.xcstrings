    "dinner_greetings.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's for dinner tonight? 🍝"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Go na le eng bakeng sa dijo tsa mantšiboa bošegong bjo? 🍝"
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku na yini eka swakudya swa madyambu namuntlha? 🍝"
          }
        },
        "ve": {
          "stringUnit": {
            "state": "translated",
            "value": "Hu na mini kha zwiḽiwa zwa madekwana namusi? 🍝"
          }
        }
      }
    },
    "dinner_greetings.2": {
      "extractionState": "manual",
      "localizations": {
