        "ve": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwavhuḓi, zwa ḓifha, zwa fusha! 🥗✨"
          }
        }
      }
    },
    "lunch_greetings.20": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halfway through the day! You deserve this. 🎉"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Seripagare sa letšatši! O swanelwa ke se. 🎉"
