    "dinner_greetings.8": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cozy dinner for a cozy night. 🕯️"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijo tsa mantšiboa tša borutho bakeng sa bošego bja borutho. 🕯️"
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "Swakudya swa madyambu swo kufumeta eka vusiku byo kufumeta. 🕯️"
          }
        },
        "ve": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwiḽiwa zwa madekwana zwa vhuḓolo kha vhusiku ha vhuḓolo. 🕯️"
          }
        }
      }
    },
    "dinner_greetings.9": {
      "extractionState": "manual",
      "localizations": {
