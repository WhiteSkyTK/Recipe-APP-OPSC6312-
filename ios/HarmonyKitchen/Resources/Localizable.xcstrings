    "morning_greetings.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A great day starts with a great meal!"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Letšatši le lebotse le thoma ka dijo tše dibotse!"
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "Siku ro saseka ri sungula hi swakudya swo saseka!"
          }
        },
        "ve": {
          "stringUnit": {
            "state": "translated",
            "value": "Ḓuvha ḽavhuḓi ḽi thoma nga zwiḽiwa zwavhuḓi!"
          }
        }
      }
    },
    "morning_greetings.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
