        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Phepo e botse, monate, e kgotsofatšago! 🥗✨"
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "Ri hanyisaka, ri nandziha, ri enerisa! 🥗✨"
