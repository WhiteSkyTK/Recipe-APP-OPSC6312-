    "dinner_greetings.7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinner vibes only! 🌟"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Maikutlo a dijo tsa mantšiboa fela! 🌟"
          }
