    "morning_greetings.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New day, new flavors! 🍯"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Letšatši le lefsa, ditatso tše difsa! 🍯"
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "Siku rintshwa, swin'wiw'wi leswintshwa! 🍯"
