    "dinner_greetings.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's make something amazing for dinner!"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "A re direng selo se se makatšago bakeng sa dijo tsa mantšiboa!"
