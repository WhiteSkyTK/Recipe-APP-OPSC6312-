    "lunch_greetings.18": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch never looked this good! 🍣"
          }
        },
        "nso": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijo tsa mosegare ga se tša ka tša bonagala gabotse bjalo! 🍣"
          }
        },
        "ts": {
          "stringUnit": {
            "state": "translated",
            "value": "Swakudya swa masiha a swi si tshama swi languteka kahle ku fana na leswi! 🍣"
