<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/welcome"
    android:background="?attr/welcomebackground"
    android:padding="32dp"
    android:fitsSystemWindows="true"
    tools:context=".WelcomeActivity">

    <!-- Main Welcome Title -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textViewSubtitle">

        <TextView
            android:id="@+id/textViewWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_to_nharmony_kitchen"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColor"
            android:textAlignment="center"/>

        <!-- The emoji is now in its own TextView -->
        <TextView
            android:id="@+id/textViewEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_emoji"
            android:textSize="32sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
    <!-- Subtitle -->
    <TextView
        android:id="@+id/textViewSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColor"
        android:text="@string/your_daily_dose_of_delicious"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonGoogleSignIn" />

    <!-- Continue with Google Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGoogleSignIn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/continue_with_google"
        android:textColor="@android:color/black"
        android:backgroundTint="@android:color/white"
        app:icon="@drawable/ic_google_logo"
        app:iconTint="@null"
        app:iconPadding="16dp"
        android:paddingVertical="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/buttonGetStarted"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Get Started Button (Register) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonGetStarted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/get_started"
        android:backgroundTint="@color/welcome_button_dark"
        android:paddingVertical="12dp"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/buttonLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- I Already Have an Account Button (Login) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/i_already_have_an_account"
        android:backgroundTint="@color/welcome_button_light_blue"
        android:textColor="@color/welcome_button_text_dark"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>