<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayoutDiscover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DiscoverFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground">

        <!-- This LinearLayout holds all the main content of your screen -->
        <LinearLayout
            android:id="@+id/discoverContentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="invisible"
            tools:visibility="visible">

            <!-- ++ ADDED THE TITLE BACK IN ++ -->
            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/discover_recipes"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingTop="24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>

            <SearchView
                android:id="@+id/searchViewRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/search_bar_background"
                android:iconifiedByDefault="false"
                android:queryHint="@string/search_recipes" />

            <Spinner
                android:id="@+id/spinnerSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewDiscover"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingHorizontal="8dp" />

        </LinearLayout>

        <!-- Include the reusable offline placeholder -->
        <include layout="@layout/fragment_offline_placeholder" />

        <!-- Include the reusable loading overlay -->
        <include layout="@layout/loading_overlay" />

    </RelativeLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

