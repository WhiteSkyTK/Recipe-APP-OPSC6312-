<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/badge_item_background"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/imageViewBadgeIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/todo"
        tools:src="@drawable/ic_badge_first_recipe"
        android:alpha="0.3"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/textViewBadgeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="Chef's Apprentice"/>

        <TextView
            android:id="@+id/textViewBadgeDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Create your first recipe."/>
    </LinearLayout>
</LinearLayout>
