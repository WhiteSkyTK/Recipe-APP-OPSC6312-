<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context=".ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Profile Header -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_profile_placeholder"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/textViewUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="Tokollo (TK)"/>

        <TextView
            android:id="@+id/textViewUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            tools:text="tk@rstinnovations.com"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditProfile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_edit_profile_icon"
                android:text="@string/edit_profile_setting"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMyRecipes"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:icon="@drawable/ic_my_recipes_icon"
                android:text="@string/my_recipes"/>
        </LinearLayout>

        <!-- Account Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/Widget.App.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/textViewBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/my_badges_achievementsbtn"
                    android:drawablePadding="16dp"
                    android:paddingVertical="12dp"
                    app:drawableStartCompat="@drawable/ic_badge" />

                <TextView
                    android:id="@+id/textViewPreferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preferences_setting"
                    android:drawablePadding="16dp"
                    android:paddingVertical="12dp"
                    app:drawableStartCompat="@drawable/ic_preferences" />

                <TextView
                    android:id="@+id/textViewLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/language"
                    android:drawablePadding="16dp"
                    android:paddingVertical="12dp"
                    app:drawableStartCompat="@drawable/ic_language" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications_setting"
                    android:drawableStart="@drawable/ic_alert"
                    android:drawablePadding="16dp"
                    android:checked="true"
                    android:enabled="false"
                    android:paddingVertical="12dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Support Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Widget.App.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_amp_about"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/textViewAboutUs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_us"
                    android:drawablePadding="16dp"
                    android:paddingVertical="12dp"
                    app:drawableStartCompat="@drawable/ic_about_us" />

                <TextView
                    android:id="@+id/textViewReportIssue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_an_issue"
                    android:drawablePadding="16dp"
                    android:paddingVertical="12dp"
                    app:drawableStartCompat="@drawable/ic_report_issue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Version Number -->
        <TextView
            android:id="@+id/textViewVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:textColor="@android:color/darker_gray"
            tools:text="@string/VersionNumber"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLogOut"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/log_out"
            android:textColor="@color/design_default_color_error"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/design_default_color_error" />

    </LinearLayout>
</ScrollView>